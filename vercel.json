{
  "buildCommand": "npm install",
  "devCommand": "npm run jora:api",
  "installCommand": "npm install",
  "framework": "node",
  "regions": ["iad1"],
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/api-cli.js"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
