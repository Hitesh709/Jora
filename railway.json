{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --omit=dev",
    "startCommand": "node src/api-cli.js"
  },
  "deploy": {
    "startCommand": "node src/api-cli.js",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
